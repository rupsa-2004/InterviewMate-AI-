WATSONX_API_KEY=Rv5FHX3hf34Nd6f8au7B6G5-3zIp1UZtkMOA2drAExTz
# Get Project ID from: watsonx.ai -> your project -> Manage -> General
WATSONX_PROJECT_ID=34a5bb77-7c6c-496d-b8af-626ebfdede48

# Regional endpoint (Frankfurt = eu-de)
WATSONX_URL=https://eu-de.ml.cloud.ibm.com

# Model ID verified available in Frankfurt (eu-de) region as of 2026-11:
#   ibm/granite-3-1-8b-base       (Granite 3.1 8B - text generation)
#   ibm/granite-4-h-small         (Granite 4 H-Small - latest)
#   meta-llama/llama-3-3-70b-instruct  (LLaMA 3.3 70B - very capable but slower)
#
# NOTE: ibm/granite-3-8b-instruct is NOT available in eu-de.
# Run:  python -m services.granite_service --list-models  to see current list.
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# Flask settings
